# Shared
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
MOBILE_DEEP_LINK_SCHEME=feeedz

# Neon Serverless Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/feeedz?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/feeedz?sslmode=require

# Supabase Auth
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
JWT_AUDIENCE=authenticated

# Cloudflare R2
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=feeedz-media
R2_PUBLIC_BASE_URL=https://media.feeedz.com

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_EVENT_POST_PRICE_ID=price_replace_me

# Google Maps
GOOGLE_MAPS_API_KEY=replace-me

# Resend
RESEND_API_KEY=re_replace_me
TICKETS_FROM_EMAIL=tickets@feeedz.com

# Moderation / Security
IMAGE_MODERATION_API_KEY=replace-me
RATE_LIMIT_WINDOW_MS=300000
PHOTO_UPLOAD_LIMIT_PER_WINDOW=1
WAF_PROVIDER=cloudflare